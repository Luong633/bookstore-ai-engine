# Định danh ứng dụng
APP_NAME="Bookstore Hybrid RAG & Recommendation Engine"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# Cấu hình cổng dịch vụ AI Microservice (Chạy cổng 8000 để không đụng cổng 8080/8082 của các Backend khác)
HOST="0.0.0.0"
PORT=8000

# Cấu hình Mô hình AI & Tìm kiếm
EMBEDDING_MODEL_NAME="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5

# Cấu hình Vector Database & LLM (Sẽ điền key thật ở Giai đoạn 2)
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION_NAME="bookstore_knowledge"
LLM_API_KEY="your_api_key_here"